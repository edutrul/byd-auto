# Copy to /etc/byd-herdr-gateway.env and replace the token with a long random
# secret (for example: openssl rand -hex 32). Keep the file root-owned, mode 600.
HERDR_SESSION=remote-tes
HERDR_GATEWAY_HOST=127.0.0.1
HERDR_GATEWAY_PORT=8790
HERDR_GATEWAY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
HERDR_BIN=/home/eduardo/.local/bin/herdr
HERDR_SOCKET_PATH=/home/eduardo/.config/herdr/sessions/remote-tes/herdr.sock
