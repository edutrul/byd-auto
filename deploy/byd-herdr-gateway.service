[Unit]
Description=BYD Herdr WebSocket gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eduardo
Group=eduardo
WorkingDirectory=/home/eduardo/byd-auto-gateway
EnvironmentFile=/etc/byd-herdr-gateway.env
ExecStart=/home/eduardo/.local/bin/bun run server/gateway.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/eduardo/.config/herdr/sessions/remote-tes

[Install]
WantedBy=multi-user.target
